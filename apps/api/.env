# Copy to apps/api/.env and adjust as needed.

PORT=3000
WEB_ORIGIN=http://localhost:5173

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.treirenecyqtibckxoxm:hpwrnvizNAP9Aurh@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.treirenecyqtibckxoxm:hpwrnvizNAP9Aurh@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth — generate strong random secrets in real environments
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Object storage (S3-compatible). Dev defaults target the MinIO container.
# In production point these at Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=musicall-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900

# Limits / lifecycle (RNF-20, RF-11)
MEDIA_MAX_BYTES_PER_USER=2147483648
TRASH_RETENTION_DAYS=30

