{
  "expo": {
    "name": "MusicAll",
    "slug": "MusicAll",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "MusicAll",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "b7d63258-31c1-4ec2-86ae-caeea1f090c4"
      }
    },
    "owner": "athosladies",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.athosladies.MusicAll",
			"buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.athosladies.MusicAll",
			"versionCode": 3
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa acessar suas fotos para definir a foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
