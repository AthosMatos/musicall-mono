{
	"name": "MusicAll",
	"main": "expo-router/entry",
	"version": "0.1.0",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint": "expo lint",
		"typecheck": "tsc --noEmit --project tsconfig.json",
		"set-version": "node ./scripts/increment-version.js",
		"copy-apk": "mkdir -p apk && cp android/app/build/outputs/apk/release/*.apk apk/musicall-aep-$(node -e \"console.log(require('./package.json').version)\").apk",
		"gen-apk-release": "NODE_ENV=production node ./scripts/increment-version.js && cd android && NODE_ENV=production ./gradlew assembleRelease && cd .. && npm run copy-apk",
		"eas-build": "eas build --platform all",
		"eas-submit-android": "eas submit --platform android",
		"eas-submit-ios": "eas submit --platform ios",
		"eas-build-and-submit": "eas build --platform all --auto-submit",
		"update": "eas update --channel production --message \"Fix login button alignment\"",
		"checkdeps": "npx depcheck"
	},
	"dependencies": {
		"@expo-google-fonts/bricolage-grotesque": "^0.4.1",
		"@expo-google-fonts/jetbrains-mono": "^0.4.1",
		"@expo/vector-icons": "^15.1.1",
		"@hookform/resolvers": "^5.2.2",
		"@monorepo/core": "workspace:*",
		"@monorepo/ui": "workspace:*",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-native-community/datetimepicker": "^8.6.0",
		"@react-native-community/netinfo": "^12.0.1",
		"@sbaiahmed1/react-native-blur": "^4.6.2",
		"@tanstack/react-query": "^5.101.1",
		"@tanstack/react-query-persist-client": "^5.101.2",
		"expo": "~55.0.6",
		"expo-av": "^16.0.8",
		"expo-constants": "~55.0.7",
		"expo-document-picker": "~55.0.14",
		"expo-font": "~55.0.4",
		"expo-image": "~55.0.6",
		"expo-image-picker": "~55.0.21",
		"expo-linear-gradient": "^55.0.15",
		"expo-linking": "~55.0.7",
		"expo-router": "~55.0.5",
		"expo-secure-store": "^55.0.15",
		"expo-splash-screen": "~55.0.10",
		"expo-status-bar": "~55.0.4",
		"jotai": "^2.18.1",
		"jotai-tanstack-query": "^0.11.0",
		"lucide-react-native": "^0.577.0",
		"nativewind": "^4.2.3",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-hook-form": "^7.72.0",
		"react-native": "0.83.6",
		"react-native-css-interop": "0.2.6",
		"react-native-currency-input": "^1.1.1",
		"react-native-gesture-handler": "~2.30.0",
		"react-native-keyboard-controller": "1.20.7",
		"react-native-reanimated": "4.2.1",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "~4.23.0",
		"react-native-svg": "^15.15.3",
		"react-native-web": "~0.21.0",
		"react-native-worklets": "0.7.2",
		"styled-components": "^6.3.12",
		"toastify-react-native": "^7.2.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/plugin-transform-react-jsx": "^8.0.1",
		"@monorepo/eslint-config": "workspace:*",
		"@types/react": "~19.2.2",
		"babel-preset-expo": "^55.0.21",
		"eslint-config-expo": "~55.0.1",
		"tailwindcss": "^3.4.17",
		"typescript": "~5.9.2"
	},
	"private": true
}
