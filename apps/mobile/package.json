{
	"name": "mobile",
	"license": "0BSD",
	"main": "expo-router/entry",
	"version": "0.0.0",
	"author": "Athos Matos",
	"description": "Musicall mobile app",
	"keywords": [
		"musicall",
		"music",
		"app",
		"mobile",
		"react-native"
	],
	"private": true,
	"engines": {
		"node": ">=24.3.0"
	},
	"reanimated": {
		"staticFeatureFlags": {
			"DISABLE_COMMIT_PAUSING_MECHANISM": true
		}
	},
	"scripts": {
		"start": "expo start",
		"lint": "biome check .",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit --project tsconfig.json",
		"eas-build-post-install": "node ./scripts/ensure-hermesc-executable.js",
		"set-version": "node ./scripts/increment-version.js",
		"copy-apk": "mkdir -p apk && cp android/app/build/outputs/apk/release/*.apk apk/drdende-$(node -e \"console.log(require('./package.json').version)\").apk",
		"gen-apk-release": "NODE_ENV=production node ./scripts/increment-version.js && cd android && NODE_ENV=production ./gradlew assembleRelease && cd .. && npm run copy-apk",
		"eas-build": "eas build --platform all",
		"eas-submit-android": "eas submit --platform android",
		"eas-submit-ios": "eas submit --platform ios",
		"eas-build-and-submit": "eas build --platform all --auto-submit",
		"update": "eas update --channel production --message \"Fix login button alignment\""
	},
	"dependencies": {
		"@expo-google-fonts/bricolage-grotesque": "^0.4.1",
		"@expo-google-fonts/jetbrains-mono": "^0.4.1",
		"@expo/metro-runtime": "~6.1.2",
		"@expo/vector-icons": "^15.0.3",
		"@hookform/resolvers": "^5.2.2",
		"@monorepo/core": "workspace:*",
		"@monorepo/ui": "workspace:*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "8.4.4",
		"@react-native-community/netinfo": "11.4.1",
		"@react-native-google-signin/google-signin": "^16.1.2",
		"@tanstack/react-form": "^1.27.6",
		"@tanstack/react-query": "^5.90.12",
		"axios": "^1.15.0",
		"chroma-js": "^3.2.0",
		"expo": "~54.0.34",
		"expo-apple-authentication": "~8.0.8",
		"expo-asset": "~12.0.13",
		"expo-blur": "~15.0.8",
		"expo-build-properties": "~1.0.10",
		"expo-constants": "~18.0.13",
		"expo-dev-client": "~6.0.21",
		"expo-document-picker": "~14.0.8",
		"expo-file-system": "~19.0.22",
		"expo-font": "~14.0.11",
		"expo-image-manipulator": "~14.0.8",
		"expo-image-picker": "^17.0.11",
		"expo-linear-gradient": "~15.0.8",
		"expo-linking": "~8.0.12",
		"expo-location": "~19.0.8",
		"expo-maps": "~0.12.10",
		"expo-navigation-bar": "^5.0.10",
		"expo-router": "~6.0.23",
		"expo-secure-store": "~15.0.8",
		"expo-splash-screen": "^31.0.13",
		"expo-system-ui": "^6.0.9",
		"expo-updates": "~29.0.17",
		"expo-web-browser": "~15.0.11",
		"jotai": "^2.16.0",
		"jotai-tanstack-query": "^0.11.0",
		"lucide-react-native": "^1.8.0",
		"react": "19.1.0",
		"react-hook-form": "^7.72.0",
		"react-native": "0.81.5",
		"react-native-edge-to-edge": "^1.7.0",
		"react-native-image-colors": "^2.6.0",
		"react-native-keyboard-aware-scroll-view": "^0.9.5",
		"react-native-leaflet-view": "^1.1.2",
		"react-native-mask-input": "^1.2.3",
		"react-native-modal": "14.0.0-rc.1",
		"react-native-reanimated": "~4.1.7",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "~4.16.0",
		"react-native-shadow-2": "^7.1.2",
		"react-native-signature-canvas": "^5.0.1",
		"react-native-svg": "15.12.1",
		"react-native-webview": "13.15.0",
		"react-native-worklets": "^0.5.1",
		"toastify-react-native": "^7.2.3",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@monorepo/eslint-config": "workspace:*",
		"@types/chroma-js": "^3.1.2",
		"@types/react": "~19.1.17",
		"dotenv": "^17.2.3",
		"eslint": "^9.39.4",
		"eslint-config-expo": "~10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.0.0",
		"metro-minify-terser": "^0.83.3",
		"prettier": "^3.8.1",
		"typescript": "~5.9.3"
	}
}
